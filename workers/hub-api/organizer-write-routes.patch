+async function requireOrganizerTournamentOwner(request, env, tournament) {
+  const ownerId =
+    String(
+      tournament.owner_id || ""
+    ).trim();
+
+  if (!ownerId) {
+    throw new ApiError(
+      403,
+      "tournament_not_owner_bound",
+      "This tournament is not linked to an organizer account."
+    );
+  }
+
+  const organizer =
+    await organizerFromBearer(
+      request,
+      env
+    );
+
+  if (
+    !timingSafeEqual(
+      String(
+        organizer.organizer_id || ""
+      ),
+      ownerId
+    )
+  ) {
+    throw new ApiError(
+      403,
+      "organizer_not_owner",
+      "This organizer does not own the tournament."
+    );
+  }
+
+  return organizer;
+}
+
+async function authorizeTournamentWrite(
+  request,
+  env,
+  tournament,
+  authMode = "managed"
+) {
+  if (authMode === "organizer") {
+    return {
+      manageToken: null,
+      organizer:
+        await requireOrganizerTournamentOwner(
+          request,
+          env,
+          tournament
+        )
+    };
+  }
+
+  return requireManageToken(
+    request,
+    env,
+    tournament
+  );
+}
