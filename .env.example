# Public application URL used for self-referential links and callbacks.
# Example: https://web.chess-publisher.org
APP_URL="http://localhost:3000"

# Optional server-side bridge for the official Chess-Results XML interface.
# The bridge owns CreatorID/AES secrets and must expose the documented
# /chessresults/{test,create,publish,admin-link,unlink} JSON contract.
CHESS_RESULTS_BRIDGE_URL=""
CHESS_RESULTS_BRIDGE_TOKEN=""
