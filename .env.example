# Public origin allowed to call the authenticated production API.
CHESS_RESULTS_WEB_ORIGIN=https://web.chess-publisher.org

# Official Chess-Results bridge. Keep both values in the host secret store.
CHESS_RESULTS_BRIDGE_URL=
CHESS_RESULTS_BRIDGE_TOKEN=

# The process listens on this port; HTTPS should terminate at the host or proxy.
PORT=3000
NODE_ENV=production
